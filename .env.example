# Copy to .env and fill in. Everything has a working local default except
# platform credentials and (optionally) real AI providers.

# --- infrastructure ---------------------------------------------------------
CCI_DATABASE_URL=postgresql+psycopg://cci:cci@localhost:5432/cci
CCI_REDIS_URL=redis://localhost:6379/0
CCI_S3_ENDPOINT=http://localhost:9000

# --- serving ------------------------------------------------------------------
CCI_PUBLIC_BASE_URL=http://localhost:3000
CCI_ADMIN_TOKEN=generate-a-long-random-string

# --- AI providers (defaults are offline fakes; flip to real providers per env) -
# CCI_LLM_PROVIDER=anthropic
# CCI_LLM_MODEL=claude-sonnet-4-6
# CCI_LLM_API_KEY=sk-ant-...
# CCI_EMBEDDING_PROVIDER=openai-compatible
# CCI_EMBEDDING_MODEL=text-embedding-3-small
# CCI_EMBEDDING_DIMS=1536
# CCI_EMBEDDING_API_KEY=sk-...
# CCI_TRANSCRIPTION_PROVIDER=faster-whisper
# CCI_OCR_PROVIDER=paddleocr

# --- Instagram (Instagram Login — no Facebook Page required) -------------------
CCI_IG_APP_ID=
CCI_IG_APP_SECRET=
CCI_IG_WEBHOOK_VERIFY_TOKEN=pick-a-random-string

# --- YouTube (owned/authorized channels only) ----------------------------------
CCI_YT_API_KEY=
